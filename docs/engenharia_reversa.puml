@startuml
skinparam classAttributeIconSize 0
left to right direction
package model {
  class Visitante {
    id: Long?
    nome: String
    visitaAutorizada: Boolean
    ultimaVisita: LocalDateTime?
    documento: String
    telefone: String?
    email: String?
    foto: String?
    active: Boolean
    dataRegistro: LocalDateTime
  }
  class Apartamento {
    id: Long?
    condominio: Condominio
    bloco: String
    numero: Int
    andar: String
    interfone: String
    active: Boolean
  }
  class AutorizacaoAcesso {
    id: Long?
    visitante: Visitante
    unidade: Apartamento
    responsavel: Usuario?
    dataInicio: LocalDate
    dataFim: LocalDate
    horaInicio: LocalTime
    horaFim: LocalTime
    permiteFimSemana: Boolean
    permiteFeriado: Boolean
    canceladaEm: LocalDateTime?
    estaCancelada(): Boolean
    estadoEm(agora: LocalDateTime): EstadoAutorizacao
    cobreData(data: LocalDate): Boolean
    dentroDoHorario(hora: LocalTime): Boolean
    cancelar(agora: LocalDateTime): AutorizacaoAcesso
  }
  class ListaAutorizados {
    id: Long?
    unidade: Apartamento
    responsavel: Usuario?
    atualizadaEm: LocalDate
    visitantes: MutableSet<Visitante>
    active: Boolean
    validaAte(): LocalDate
    vigenteEm(data: LocalDate): Boolean
    contem(visitanteId: Long?): Boolean
  }
  class RegistroAcesso {
    id: Long?
    autorizacao: AutorizacaoAcesso
    unidadeId: Long
    porteiroId: Long
    entradaEm: LocalDateTime
    saidaEm: LocalDateTime?
    porteiroSaidaId: Long?
    visitaAberta(): Boolean
    registrarSaida(agora: LocalDateTime, porteiroId: Long): RegistroAcesso
  }
  class Feriado {
    id: Long?
    data: LocalDate
    nome: String
  }
  enum EstadoAutorizacao {
  }
}
package repository {
  interface VisitanteRepository {
    findAllByActiveTrue(): List<Visitante>
    findByIdAndActiveTrue(id: Long): Visitante?
    findFirstByDocumento(documento: String): Visitante?
    buscarPorNome(@Param("nome")
  }
  interface ListaAutorizadosRepository {
    findFirstByUnidadeIdAndActiveTrueOrderByAtualizadaEmDescIdDesc(unidadeId: Long): ListaAutorizados?
  }
  interface AutorizacaoAcessoRepository {
    findAllByVisitanteIdAndUnidadeId(visitanteId: Long, unidadeId: Long): List<AutorizacaoAcesso>
    findAllByVisitanteId(visitanteId: Long): List<AutorizacaoAcesso>
    findAllByUnidadeId(unidadeId: Long): List<AutorizacaoAcesso>
  }
  interface RegistroAcessoRepository {
    findAllBySaidaEmIsNull(): List<RegistroAcesso>
    findAllByUnidadeId(unidadeId: Long): List<RegistroAcesso>
  }
}
package service {
  class ControleAcessoService {
    visitanteRepository: VisitanteRepository
    listaRepository: ListaAutorizadosRepository
    autorizacaoRepository: AutorizacaoAcessoRepository
    registroRepository: RegistroAcessoRepository
    calendario: CalendarioFeriados
    falhas: InjetorFalhas
    avaliarEntrada(visitanteId: Long?,
        unidadeId: Long,
        documento: String,
        agora: LocalDateTime): DecisaoAcesso
    registrarEntrada(autorizacaoId: Long,
        porteiroId: Long,
        documento: String,
        agora: LocalDateTime): ResultadoEntrada
    registrarSaida(registroId: Long, porteiroId: Long, agora: LocalDateTime): ResultadoSaida
    lerRegistros(): List<RegistroAcesso>
    lerAbertos(): List<RegistroAcesso>
    lerRegistro(id: Long): RegistroAcesso?
  }
  class AutorizacaoService {
    autorizacaoRepository: AutorizacaoAcessoRepository
    listaRepository: ListaAutorizadosRepository
    visitanteRepository: VisitanteRepository
    apartamentoRepository: ApartamentoRepository
    usuarioRepository: UsuarioRepository
    conceder(visitanteId: Long,
        unidadeId: Long,
        responsavelId: Long?,
        dataInicio: LocalDate,
        dataFim: LocalDate,
        horaInicio: LocalTime,
        horaFim: LocalTime,
        permiteFimSemana: Boolean,
        permiteFeriado: Boolean): AutorizacaoAcesso?
    cancelar(autorizacaoId: Long, agora: LocalDateTime): Boolean
    revisarLista(unidadeId: Long,
        visitanteIds: List<Long>,
        responsavelId: Long?,
        atualizadaEm: LocalDate): ListaAutorizados?
    lerAutorizacao(id: Long): AutorizacaoAcesso?
    lerAutorizacoes(): List<AutorizacaoAcesso>
    lerListaVigente(unidadeId: Long): ListaAutorizados?
  }
  class VisitanteService {
    repository: VisitanteRepository
    lerTodos(): List<Visitante>
    lerPorId(id: Long): Visitante?
    cadastrar(visitante: Visitante)
    apagar(id: Long): Boolean
    atualizar(id: Long, visitante: Visitante): Boolean
    buscarPorNome(nome: String): List<Visitante>
  }
  class MassaTesteService {
    relogio: RelogioControlavel
    condominioRepository: CondominioRepository
    apartamentoRepository: ApartamentoRepository
    usuarioRepository: UsuarioRepository
    visitanteRepository: VisitanteRepository
    listaRepository: ListaAutorizadosRepository
    autorizacaoRepository: AutorizacaoAcessoRepository
    registroRepository: RegistroAcessoRepository
    feriadoRepository: FeriadoRepository
    passwordEncoder: PasswordEncoder
    restaurarB0(): Map<String
  }
  interface Relogio {
    agora(): LocalDateTime
  }
  interface CalendarioFeriados {
    ehFeriado(data: LocalDate): Boolean
  }
  interface InjetorFalhas {
    verificar(ponto: PontoDeFalha)
  }
  class DecisaoAcesso {
    permitido: Boolean
    motivo: MotivoNegacao?
    mensagem: String
    autorizacao: AutorizacaoAcesso?
  }
  class ResultadoEntrada {
    decisao: DecisaoAcesso
    registro: RegistroAcesso?
  }
  class ResultadoSaida {
    status: StatusSaida
    registro: RegistroAcesso?
  }
}
package controller {
  class AcessoController {
    service: ControleAcessoService
    relogio: Relogio
    mapper: ControleAcessoMapper
    avaliar(@Valid @RequestBody dto: AvaliarEntradaDTORequest): ResponseEntity<DecisaoAcessoDTOResponse>
    registrarEntrada(@Valid @RequestBody dto: RegistrarEntradaDTORequest,
        authentication: Authentication): ResponseEntity<Any>
    registrarSaida(@PathVariable("id")
    lerTodos(): List<RegistroAcessoDTOResponse>
    lerAbertos(): List<RegistroAcessoDTOResponse>
    lerPorId(@PathVariable("id")
  }
  class AutorizacaoController {
    service: AutorizacaoService
    relogio: Relogio
    mapper: ControleAcessoMapper
    conceder(@Valid @RequestBody dto: AutorizacaoDTORequest,
        authentication: Authentication): ResponseEntity<Any>
    lerTodas(): List<AutorizacaoDTOResponse>
    lerPorId(@PathVariable("id")
    cancelar(@PathVariable("id")
    revisarLista(@PathVariable("unidadeId")
    lerLista(@PathVariable("unidadeId")
  }
  class FeriadoController {
    repository: FeriadoRepository
    mapper: ControleAcessoMapper
    lerTodos(): List<FeriadoDTOResponse>
    cadastrar(@Valid @RequestBody dto: FeriadoDTORequest): ResponseEntity<Any>
    apagar(@PathVariable("id")
  }
  class TesteController {
    relogio: RelogioControlavel
    massa: MassaTesteService
    falhas: FalhasControlaveis
    lerRelogio(): Map<String
    definirRelogio(@RequestBody corpo: Map<String, String>): ResponseEntity<Any>
    restaurarRelogio(): Map<String
    restaurarMassa(): Map<String
    ativarFalha(@PathVariable("ponto")
    limparFalhas(): Map<String
    lerFalhas(): Map<String
  }
}
